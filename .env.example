# Local handoff defaults
PORT=3000
NODE_ENV=development
COMPLIANCE_ENV=LOCAL
DATABASE_PATH=./data/local/am_business_platform.db
PERSISTENT_DATA_PATH=./data/local
REQUIRE_PERSISTENT_STORAGE=false
STRICT_PERSISTENCE_ABORT=false

# Demo mode is OFF by default for production and clean local installs.
DEMO_MODE=false
ALLOW_DEMO_SEED_DATA=false

# Security and identity configuration
AUTH_TOKEN_SECRET=
JWT_SECRET=
INITIAL_ADMIN_PASSWORD=
INITIAL_CASHIER_PIN=

# Optional integrations
ETA_CLIENT_ID=
ETA_CLIENT_SECRET=
GEMINI_API_KEY=
ZATCA_CERTIFICATE_PEM=
ZATCA_CSID=
ZATCA_CSID_SECRET=
PERSISTENCE_MODE=sqlite
